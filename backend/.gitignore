# ==============================================================================
# Pulse Real-Time Backend Microservice — .gitignore
# ==============================================================================

# Dependencies
node_modules/

# Production Builds
dist/
build/

# Environment Variables & Secrets
.env
.env.*
*.env
*.local
!.env.example

# Runtime Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploaded Files & Audio Voice Notes (preserve .gitkeep)
uploads/*
!uploads/.gitkeep

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sw?
*.bak
*.tmp
