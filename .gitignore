# ==============================================================================
# Pulse Real-Time Messaging & Collaboration — Root .gitignore
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Production Builds & Bundler Caches
dist/
*/dist/
dist-ssr/
*/dist-ssr/
build/
*/build/
.vite/
*/.vite/
*.tsbuildinfo

# Environment Variables & Secrets
.env
.env.*
*.env
*.local
!.env.example
!*/.env.example

# Runtime Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Uploads & Voice Audio Recordings (preserve .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# Linter & Coverage Caches
.eslintcache
.stylelintcache
coverage/

# OS & IDE
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sw?
*.bak
*.tmp
